# ============================================================
# 企业级混合检索 RAG 知识问答平台
# 环境变量示例文件
# 复制此文件为 .env 并填入实际值
# ============================================================

# -------------------- 基础配置 --------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# -------------------- 应用配置 --------------------
APP_NAME=rag-knowledge
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=your-secret-key-change-in-production
APP_ALGORITHM=HS256
APP_ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------- 数据库配置 --------------------
# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=rag_knowledge
DATABASE_USER=rag_user
DATABASE_PASSWORD=your-db-password
DATABASE_URL=postgresql+asyncpg://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}
DATABASE_SYNC_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# -------------------- MinIO 配置 --------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_TEMP=temp

# -------------------- OpenSearch 配置 --------------------
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_SCHEME=http
OPENSEARCH_URL=${OPENSEARCH_SCHEME}://${OPENSEARCH_USER}:${OPENSEARCH_PASSWORD}@${OPENSEARCH_HOST}:${OPENSEARCH_PORT}

# -------------------- Celery 配置 --------------------
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# -------------------- LLM 配置 --------------------
# LLM Provider: openai / anthropic / azure / local
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_RERANKER_MODEL=cohere-rerank-4

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Azure OpenAI
AZURE_OPENAI_API_KEY=your-azure-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# -------------------- Embedding 配置 --------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=100

# -------------------- Reranker 配置 --------------------
RERANKER_PROVIDER=openai
RERANKER_MODEL=cohere-rerank-4
RERANKER_TOP_N=10

# -------------------- OCR 配置 --------------------
OCR_PROVIDER=local
OCR_LANGUAGES=chi_sim+eng,eng

# -------------------- 向量数据库配置 --------------------
VECTOR_DB_TYPE=pgvector
PGVECTOR_DIMENSION=${EMBEDDING_DIMENSION}

# -------------------- CORS 配置 --------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -------------------- 监控配置 --------------------
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# -------------------- 审计配置 --------------------
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90

# -------------------- 成员6 检索/问答（名称说明，不填真实密钥）--------------------
# QUERY_CACHE_TTL_SECONDS 查询/答案缓存 TTL（秒），可选
# RETRIEVAL_RRF_K RRF 参数 k，可选
# RETRIEVAL_TOP_K 单路召回 Top-K，可选
# RETRIEVAL_TOKEN_BUDGET 上下文 Token 预算，可选
# RETRIEVAL_ALLOW_PARTIAL_DEGRADE 单路失败是否允许降级（true/false），可选
# OPENSEARCH_CHUNK_INDEX OpenSearch Chunk 索引名，可选


# -------------------- 文件上传配置 --------------------
MAX_UPLOAD_SIZE=104857600  # 100MB
ALLOWED_EXTENSIONS=pdf,docx,doc,xlsx,xls,pptx,ppt,txt,md,html,htm
